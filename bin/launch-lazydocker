#!/usr/bin/env bash
set -euo pipefail

# Stay out of the docker group (root-equivalent). If this session cannot write
# the socket, elevate with polkit instead of `sudo lazydocker`.
# Same idea as omarchy-launch-docker-tui / omarchy-sudo-docker.

socket="${DOCKER_SOCKET:-/var/run/docker.sock}"

if command -v mise >/dev/null 2>&1; then
  bin="$(mise which lazydocker)" || {
    echo "launch-lazydocker: mise which lazydocker failed" >&2
    exit 127
  }
else
  bin="$(command -v lazydocker)" || {
    echo "launch-lazydocker: lazydocker not on PATH" >&2
    exit 127
  }
fi

if [[ -w "$socket" ]]; then
  exec "$bin" "$@"
fi

exec pkexec-run "$bin" "$@"
