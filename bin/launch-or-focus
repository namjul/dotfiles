#!/usr/bin/env bash

# Usage: launch-or-focus <window-pattern> <launch-command...>
# Niri: match app_id or title (case-insensitive regex), else spawn in background.

if (($# < 2)); then
  echo "Usage: $0 <window-pattern> <launch-command...>" >&2
  exit 1
fi

APP_PATTERN=$1
shift
LAUNCH=("$@")

WINDOW_ID=$(niri msg --json windows 2>/dev/null | jq -r --arg p "$APP_PATTERN" '
  .[]? | select(((.app_id // "") | test($p; "i")) or ((.title // "") | test($p; "i"))) | .id
' | head -n1)

if [[ -n $WINDOW_ID ]]; then
  niri msg action focus-window --id="$WINDOW_ID"
else
  setsid "${LAUNCH[@]}" >/dev/null 2>&1 &
fi
