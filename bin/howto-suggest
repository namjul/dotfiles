#!/usr/bin/env bash
# Print a shell command suggestion for a query (no TTY injection). Same providers as antonmedv/howto.
set -euo pipefail

usage() {
  echo "usage: howto-suggest <query...>" >&2
  exit 1
}

sanitize_command() {
  local cmd=$1
  cmd="${cmd#"${cmd%%[![:space:]]*}"}"
  cmd="${cmd%"${cmd##*[![:space:]]}"}"
  cmd="${cmd#\`}"
  cmd="${cmd%\`}"
  cmd=${cmd//$'\n'/ }
  printf '%s' "$cmd"
}

build_prompt() {
  local cmd=$1
  local os=linux
  [[ $(uname -s) == Darwin ]] && os=mac
  cat <<EOF

You are a command line assistant that can help users with their tasks.
User want assistance with the following command:

${cmd}

Assistant should respond with a command that can be used to achieve the desired result.
Command shoud be suitable for ${os} OS.
Output only the command, do not include any additional text.
Do not include any quotes or backticks in the output.
EOF
}

pick_provider() {
  if [[ -n ${OPENAI_API_KEY-} ]]; then
    printf '%s\t%s\t%s\n' "https://api.openai.com/v1/chat/completions" "${HOWTO_MODEL:-gpt-4o}" "$OPENAI_API_KEY"
  elif [[ -n ${GEMINI_API_KEY-} ]]; then
    printf '%s\t%s\t%s\n' \
      "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions" \
      "${HOWTO_MODEL:-gemini-3.8-flash}" \
      "$GEMINI_API_KEY"
  elif [[ -n ${DEEPSEEK_API_KEY-} ]]; then
    printf '%s\t%s\t%s\n' "https://api.deepseek.com/chat/completions" "${HOWTO_MODEL:-deepseek-chat}" "$DEEPSEEK_API_KEY"
  else
    echo "error: no API key found" >&2
    echo "set one of: OPENAI_API_KEY, GEMINI_API_KEY, DEEPSEEK_API_KEY" >&2
    return 1
  fi
}

query_llm() {
  local endpoint=$1 model=$2 api_key=$3 prompt=$4
  local body
  body=$(jq -n \
    --arg model "$model" \
    --arg content "$prompt" \
    '{model: $model, messages: [{role: "user", content: $content}], max_tokens: 1000}')

  local response http_code
  response=$(curl -sS -w '\n%{http_code}' -X POST "$endpoint" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $api_key" \
    -d "$body")
  http_code=${response##*$'\n'}
  response=${response%$'\n'*}

  if [[ $http_code != "200" ]]; then
    local msg
    msg=$(jq -r '.error.message // empty' <<<"$response" 2>/dev/null || true)
    if [[ -n $msg ]]; then
      echo "error: API error: $msg" >&2
    else
      echo "error: API returned status $http_code" >&2
    fi
    return 1
  fi

  jq -r '.choices[0].message.content // empty' <<<"$response"
}

[[ $# -ge 1 ]] || usage

query=$(sanitize_command "$*")
[[ -n $query ]] || usage

IFS=$'\t' read -r endpoint model api_key < <(pick_provider) || exit 1

prompt=$(build_prompt "$query")
content=$(query_llm "$endpoint" "$model" "$api_key" "$prompt") || exit 1

if [[ -z $content ]]; then
  echo "error: empty response from model" >&2
  exit 1
fi

sanitize_command "$content"
