#!/usr/bin/env -S deno run --allow-all

import { fs } from "zx";
import { assert, command, fetch, file, init, path, variable, variables } from "fig";

init(import.meta.dirname);

variables(() => ({
  files: [".vimrc", ".config/nvim"],
}));

const NEOVIM_VERSION = "v0.12.5";

// make directories
{
  await file({ path: "~/opt/nvim", state: "directory" });
  await file({ path: "~/.config", state: "directory" });
}

// Keep ~/opt/nvim AppImage + squashfs-root at NEOVIM_VERSION (PATH prefers that tree).
const nvimRoot = path.home.join("opt/nvim").toString();
const location = `${nvimRoot}/nvim${NEOVIM_VERSION}.appimage`;
const extractedNvim = `${nvimRoot}/squashfs-root/usr/bin/nvim`;
const squashfsRoot = `${nvimRoot}/squashfs-root`;

const appimageUrl =
  `https://github.com/neovim/neovim/releases/download/${NEOVIM_VERSION}/nvim-linux-x86_64.appimage`;

const downloadAppimage = async (force = false): Promise<void> => {
  const dl = await fetch({
    url: appimageUrl,
    dest: location,
    encoding: null,
    mode: "0755",
    ...(force ? { force: true } : {}),
  });
  assert.result(dl);
};

if (!fs.existsSync(location)) {
  await downloadAppimage();
}

const extractedMatchesPin = async (): Promise<boolean> => {
  if (!fs.existsSync(extractedNvim)) return false;
  const ver = await command(extractedNvim, ["--version"]);
  if (!ver.ok) return false;
  const firstLine = ver.value.stdout.split("\n")[0] ?? "";
  return firstLine.includes(NEOVIM_VERSION);
};

if (!(await extractedMatchesPin())) {
  if (fs.existsSync(squashfsRoot)) {
    const removed = await command("rm", ["-rf", squashfsRoot]);
    assert.result(removed);
  }
  let extract = await command(location, ["--appimage-extract"], {
    chdir: nvimRoot,
    raw: true,
  });
  if (!extract.ok) {
    await downloadAppimage(true);
    extract = await command(location, ["--appimage-extract"], {
      chdir: nvimRoot,
      raw: true,
    });
  }
  assert.result(extract);
}


// create symlinks
{
  const files = await variable.paths("files");

  for (const src of files) {
    await file({
      force: true,
      path: path.home.join(src).toString(),
      src: path.aspect.join("files", src).toString(),
      state: "link",
    });
  }
}

// Python host for :python3 / provider-python
await command("python3", ["-m", "pip", "install", "pynvim", "pillow"]);

// index help tags so :help writing-session (and any future doc/ files) work
await command("nvim", ["--headless", "-c", "helptags ~/.config/nvim/doc", "-c", "quit"]);
