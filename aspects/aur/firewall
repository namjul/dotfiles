#!/bin/bash
# mise description="Set up ufw firewall"

trap 'echo "Warning: A command has failed. Exiting the script. Line was ($0:$LINENO): $(sed -n "${LINENO}p" "$0")"; exit 3' ERR
set -Eeuo pipefail

sudo ufw default deny incoming
sudo ufw default allow outgoing

# LocalSend — https://wiki.archlinux.org/title/LocalSend (default port 53317; configurable in app)
sudo ufw allow 53317/tcp comment 'LocalSend'
sudo ufw allow 53317/udp comment 'LocalSend'

sudo ufw --force enable
sudo systemctl enable ufw
