#!/bin/bash
# mise description="Install pinned Zenkai app launcher into ~/.local/share/zenkai"
# mise interactive=true
#USAGE flag "--force" help="Reinstall even if this version is already installed"
# https://github.com/dayvster/zenkai
# App launcher (niri/sway/i3 $mod+space) and passmenu. Not a dmenu: system/kanshi/share menus stay on wofi.
# Optional on a fresh tree until //aspects/aur:default. Also: mise run //aspects/aur:zenkai

trap 'echo "Warning: A command has failed. Exiting the script. Line was ($0:$LINENO): ${BASH_COMMAND}"; exit 3' ERR
set -euo pipefail

VERSION="v1.3"
URL="https://github.com/dayvster/zenkai/releases/download/${VERSION}/zenkai-v1.3-linux-x64.tar.gz"
SHA256="ffec2bdd063548c7ea4eb02e0878fdb6d81c1c6e10b39eb6467d0ad9612ec99c"
DEST="${XDG_DATA_HOME:-$HOME/.local/share}/zenkai/zenkai"
VERSION_MARKER="${XDG_STATE_HOME:-$HOME/.local/state}/zenkai-version"

already_installed() {
  [[ -x $DEST ]] || return 1
  [[ -f $VERSION_MARKER ]] || return 1
  [[ "$(cat "$VERSION_MARKER")" == "$VERSION" ]]
}

if [[ "${usage_force:-}" != "true" ]] && already_installed; then
  echo "zenkai ${VERSION} already at ${DEST} — skip install (pass --force to reinstall)"
  exit 0
fi

if [[ -e /etc/arch-release ]] && ! pacman -Q qt6-base >/dev/null 2>&1; then
  echo "sudo: cache credentials before installing qt6-base"
  sudo -v
  sudo pacman -S --needed --noconfirm qt6-base
elif [[ ! -e /etc/arch-release ]] && ! ldconfig -p 2>/dev/null | grep -q 'libQt6Widgets.so'; then
  echo "zenkai: libQt6Widgets not found; installing the binary anyway" >&2
fi

tmpdir="$(mktemp -d)"
cleanup() { rm -rf "$tmpdir"; }
trap cleanup EXIT

curl -fsSL -o "$tmpdir/zenkai.tar.gz" "$URL"
echo "${SHA256}  $tmpdir/zenkai.tar.gz" | sha256sum --check --status
tar -xzf "$tmpdir/zenkai.tar.gz" -C "$tmpdir"
install -Dm755 "$tmpdir/zenkai-v1.3-linux-x64/zenkai" "$DEST"
mkdir -p "$(dirname "$VERSION_MARKER")"
printf '%s\n' "$VERSION" >"$VERSION_MARKER"
echo "Installed ${DEST} (${VERSION}). Launch with: zenkai"
