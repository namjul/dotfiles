#!/usr/bin/env bash
# Start redshift with a method that matches the session.
# systemd unit files expand ${...}, so card discovery cannot live in ExecStart.
set -euo pipefail

if [[ ${XDG_SESSION_TYPE:-} != wayland ]]; then
  exec /usr/bin/redshift -v
fi

# drm defaults to card0; this machine (and others) may only expose card1+.
shopt -s nullglob
cards=(/dev/dri/card[0-9]*)
n=${cards[0]##*card}
exec /usr/bin/redshift -v -m "drm:card=${n}"
