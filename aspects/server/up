#!/usr/bin/env bash

trap 'echo "Warning: A command has failed. Exiting the script. Line was ($0:$LINENO): $(sed -n "${LINENO}p" "$0")"; exit 3' ERR
set -Eeuo pipefail

DIR="$(dirname "$(realpath "$0")")"
FILES_DIR="$DIR/files"
TEMP_DIR=$(mktemp -d)
trap 'rm -rf "$TEMP_DIR"' EXIT

cp -r "$FILES_DIR/srv/square/aspects" "$TEMP_DIR/aspects"
cp -r "$FILES_DIR/srv/square/tasks" "$TEMP_DIR/tasks"
cp "$FILES_DIR/srv/square/.mise.toml" "$TEMP_DIR/.mise.toml"
find "$TEMP_DIR" -type f -exec sed -i \
  -e "s|\${SQUARE_PATH}|$SQUARE_PATH|g" \
  -e "s|{SQUARE_PATH}|$SQUARE_PATH|g" {} +

# --delete only under aspects/; .mise.toml at square root; do not touch data/ etc.
rsync --delete --quiet -rpt --compress --chown=:square \
  --include='aspects/' \
  --include='aspects/**' \
  --include='tasks/' \
  --include='tasks/**' \
  --include='.mise.toml' \
  --exclude='*' \
  "$TEMP_DIR/" "$SERVER:$SQUARE_PATH/"

sshcmd="
cd \"$SQUARE_PATH\" && mise trust --all
echo \"Square monorepo tasks:\"
mise tasks ls --all --name-only

if systemctl is-active pitchfork.service &>/dev/null; then
  systemctl restart pitchfork.service
fi
"

ssh $SERVER "bash -l -c '$sshcmd'"
