#!/usr/bin/env bash

trap 'echo "Warning: A command has failed. Exiting the script. Line was ($0:$LINENO): $(sed -n "${LINENO}p" "$0")"; exit 3' ERR
set -Eeuo pipefail

tailscale_backend_state() {
  tailscale status --json 2>/dev/null | jq -r '.BackendState // empty' 2>/dev/null || true
}

if ! command -v tailscale &>/dev/null; then
  curl -fsSL https://tailscale.com/install.sh | sh
fi

systemctl enable --now tailscaled

backend_state="$(tailscale_backend_state)"
if [[ "${backend_state}" == "Running" ]]; then
  echo "Tailscale already joined (BackendState=Running)."
  exit 0
fi

echo "Tailscale is installed but not joined to the tailnet."
echo "From the laptop (aspects/server): SERVER=${SERVER:-homelab} mise run tailscale:join"
exit 0
