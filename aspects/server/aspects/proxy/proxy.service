[Unit]
Description=CORS proxy (homelab)
After=network.target network-online.target
Requires=network-online.target

[Service]
Type=simple
Environment=HOME=/root
EnvironmentFile=-/etc/environment
ExecStart=/root/.local/bin/mise exec node -- node /root/.config/proxy/server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
