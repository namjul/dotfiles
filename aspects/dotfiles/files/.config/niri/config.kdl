// Arch niri session — slice 1 (docs/plans/niri-migration-s1.md)
// Session daemons (mako, waybar, swaybg, kanshi, polkit, udiskie, swayosd) run via systemd, not spawn-at-startup.
// Idle/lock: swayidle + niri msg for DPMS (niri wiki Example-systemd-Setup; no native idle block yet).
// Keybindings: niri defaults (/usr/share/doc/niri/default-config.kdl) + personal app layer below.

input {
    keyboard {
        xkb {
            layout "de"
        }
        repeat-delay 200
        repeat-rate 30
    }
    touchpad {
        tap
    }
}

layout {
    gaps 10
    focus-ring {
        on
        width 2
        active-color "#bdae93"
        inactive-color "#504945"
        urgent-color "#cc241d"
    }
    border {
        off
    }
}

hotkey-overlay {
    skip-at-startup
}

window-rule {
    match app-id="org.namjul.float-win"
    open-floating true
}

window-rule {
    match app-id="float-win"
    open-floating true
}

window-rule {
    match app-id="Espanso.SyncTool"
    open-floating true
}

binds {

    Mod+Shift+R { spawn-sh "niri msg action load-config-file"; }
    Mod+Shift+7 { show-hotkey-overlay; }
    Mod+Return hotkey-overlay-title="Terminal: launch-terminal" { spawn "launch-terminal"; }
    Mod+Q repeat=false { close-window; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Space hotkey-overlay-title="App launcher: wofi" { spawn "wofi" "--show" "drun"; }

    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }

    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }

    Mod+W { toggle-column-tabbed-display; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    Mod+F { maximize-column; }
    Mod+Shift+Space { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }

    Mod+Shift+U { move-column-to-workspace-down; }
    Mod+Shift+I { move-column-to-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }

    Super+Alt+L allow-inhibiting=false hotkey-overlay-title="Lock: swaylock" { spawn "swaylock" "-f"; }

    Print { spawn "capture-screenshot"; }
    Mod+Shift+S { spawn "capture-screenshot"; }
    Mod+Shift+Ctrl+S { spawn "capture-screenshot" "fullscreen"; }

    Mod+Shift+Ctrl+H { move-workspace-to-monitor-left; }
    Mod+Shift+Ctrl+J { move-workspace-to-monitor-down; }
    Mod+Shift+Ctrl+K { move-workspace-to-monitor-up; }
    Mod+Shift+Ctrl+L { move-workspace-to-monitor-right; }

    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+J { focus-monitor-down; }
    Mod+Ctrl+K { focus-monitor-up; }
    Mod+Ctrl+L { focus-monitor-right; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
    XF86AudioMute allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "toggle-mic-mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "swayosd-client" "--brightness" "raise"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "swayosd-client" "--brightness" "lower"; }

    // quit shows niri's built-in confirmation dialog (default-config.kdl).
    Mod+Shift+E { quit; }
    Mod+B { spawn "chromium"; }
    Mod+T { spawn-sh "gtk-launch telegram"; }
    Mod+M { spawn-sh "gtk-launch email"; }
    Mod+C { spawn-sh "gtk-launch calendar"; }
    Mod+D { spawn-sh "gtk-launch devdocs"; }
    Mod+V { spawn-sh "launch-terminal --title=Btop btop"; }
    Mod+N { spawn-sh "launch-terminal --title=Neovim nvim"; }
    Mod+A { spawn-sh "gtk-launch chatgpt"; }
    Mod+Shift+A { spawn-sh "gtk-launch claude"; }
    Mod+Ctrl+A { spawn-sh "gtk-launch deepseek"; }
    Mod+Y { spawn-sh "gtk-launch youtube"; }
    Mod+Shift+D { spawn-sh "launch-terminal --title=Lazydocker launch-lazydocker"; }
    Mod+Shift+F { spawn-sh "gtk-launch org.gnome.Nautilus"; }
    Mod+Shift+M { spawn-sh "gtk-launch spotify"; }
    Mod+Shift+T { spawn "darkman" "toggle"; }
    Mod+Z { spawn "do-not-disturb"; }

    Mod+Escape hotkey-overlay-title="System menu: wofi" { spawn "system-menu"; }
    Mod+X hotkey-overlay-title="Display profile: wofi" { spawn "kanshi-menu"; }

    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+R { switch-preset-column-width; }
}
