# Output ids from `mise run //aspects/dotfiles:display-outputs` (make model serial).
# Among matching profiles, kanshi prefers the one that names more outputs, so `mobile` is the undock fallback.

profile mobile {
	output "Lenovo Group Limited 0x403A Unknown" {
		enable
		scale 1
		position 0,0
	}
}

profile dockedhome {
	output "Lenovo Group Limited 0x403A Unknown" {
		enable
		scale 2
		position 0,0
	}
	output "Dell Inc. DELL U2719DC 56645R2" {
		enable
		scale 1
		mode 2560x1440
		position 0,720
	}
}

profile dockedhomeup {
	output "PNP(AOC) Q24G2 ZQVPBHA005769" {
		enable
		scale 1
		mode 2560x1440
		position 0,0
	}
	output "Lenovo Group Limited 0x403A Unknown" {
		enable
		scale 1
		position 0,1440
	}
}

profile dockedoffice {
	output "Dell Inc. DELL U2412M Y1H5T2C5138L" {
		enable
		scale 1
		mode 1920x1200
		position 0,0
	}
	output "Lenovo Group Limited 0x403A Unknown" disable
}
