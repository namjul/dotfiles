#!/usr/bin/env bash
# Launch a URL as a Chromium-style app window (via default web browser).
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: launch-webapp <url> [extra browser flags...]" >&2
  exit 1
fi

url=$1
shift

browser=$(xdg-settings get default-web-browser 2>/dev/null || true)

case $browser in
*chromium* | google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

browser_bin=""
for applications_dir in \
  "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
  "/usr/share/applications"; do
  desktop_file="$applications_dir/$browser"
  if [[ -r $desktop_file ]]; then
    browser_bin=$(grep -E '^Exec=' "$desktop_file" | head -1 | sed -E 's/^Exec=([^[:space:]%]+).*/\1/')
    break
  fi
done

exec setsid uwsm-app -- "$browser_bin" --app="$url" "$@"
