{
  "manifest_version": 3,
  "name": "Copy URL",
  "version": "2.0.0",
  "description": "Copy the active tab URL (format in background.js)",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "commands": {
    "copy-url": {
      "suggested_key": {"default": "Alt+C"},
      "description": "Copy URL"
    }
  },
  "background": {"service_worker": "background.js"}
}
