#!/bin/bash
# mise description="Snapshot Timewarrior data into $DATA_BACKUP"

trap 'echo "Warning: A command has failed. Exiting the script. Line was ($0:$LINENO): $(sed -n "${LINENO}p" "$0")"; exit 3' ERR
set -Eeuo pipefail

DROPBOX_DIR="${DROPBOX_DIR:-$HOME/Dropbox}"
DATA_BACKUP="${DATA_BACKUP:-$DROPBOX_DIR/backup}"
src="${XDG_DATA_HOME:-$HOME/.local/share}/timewarrior"

if [[ ! -e "$src" ]]; then
  echo "skip: no $src"
  exit 0
fi

if [[ -L "$src" ]]; then
  src="$(readlink -f "$src")"
fi

stamp="$DATA_BACKUP/timewarrior.$(date +'%Y.%m.%d-%H%M%S')"
mkdir -p "$DATA_BACKUP"
cp -a "$src" "$stamp"
echo "snapshot $src -> $stamp"
